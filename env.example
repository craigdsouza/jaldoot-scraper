# Jaldoot Scraper Environment Configuration Template
# Copy this file to .env and update the values according to your setup

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jaldoot_db
DB_USER=jaldoot_user
DB_PASSWORD=your_secure_password_here

# For Google Cloud SQL (Cloud Run/Compute Engine):
# DB_HOST=/cloudsql/your-project-id:us-central1:jaldoot-db
# DB_INSTANCE_CONNECTION_NAME=your-project-id:us-central1:jaldoot-db

# ==========================================
# RUNTIME CONFIGURATION
# ==========================================

# Chrome WebDriver path
# For Windows: chromedriver.exe
# For Linux/Mac: /usr/local/bin/chromedriver or ./chromedriver
CHROME_DRIVER_PATH=chromedriver.exe

# Run Chrome in headless mode (recommended for servers)
HEADLESS=true

# Enable detailed debug logging
DEBUG=false

# Test mode is not used in the current CLI workflow

# ==========================================
# FILE PATHS
# ==========================================

# Log file path
LOG_FILE=logs/jaldoot.log

# Status file for real-time monitoring
STATUS_FILE=status.json

# ==========================================
# SCRAPING PARAMETERS
# ==========================================

# HTML table ID to scrape from (defaults are sensible; override if needed)
TABLE_ID=ContentPlaceHolder1_gvReport

# ==========================================
# ADDITIONAL SETTINGS
# ==========================================

# Optional cloud settings can be added per deployment needs

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================

# Development toggles are not required for current CLI usage

# ==========================================
# SECURITY NOTES
# ==========================================
#
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique passwords for database access
# 3. Rotate credentials regularly
# 4. Use environment-specific configuration files (.env.prod, .env.dev)
# 5. Consider using GCP Secret Manager for production deployments
